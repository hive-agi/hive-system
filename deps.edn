{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.9.865"}

        ;; Result ADT + DSL macros (railway-oriented programming)
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.15"}

        ;; Event system (interceptors, effects/coeffects, FSM)
        io.github.hive-agi/hive-events {:mvn/version "0.5.6"}

        ;; Ports this system implements — ISigner, so a licence can be signed
        ;; through whichever ICrypto a host has already built.
        io.github.hive-agi/hive-spi {:mvn/version "0.1.20"}

        ;; Bounded parallel execution (pmap, fork-join, gate)
        io.github.hive-agi/hive-weave {:mvn/version "0.3.1"}

        ;; Filesystem utilities (which, glob, exists?, list-dir, etc.)
        babashka/fs {:mvn/version "0.5.34"}

        ;; Datahike — Clojure-native Datalog database (temporal storage)
        org.replikativ/datahike {:mvn/version "0.8.1788"}

        ;; Logging
        com.taoensso/timbre {:mvn/version "6.8.0"}

        ;; JSON encoding for HTTP-bound GPU executors (ollama, vllm REST)
        org.clojure/data.json {:mvn/version "2.5.2"}

        ;; Crypto: Tink (default ICrypto adapter — pure-Java)
        com.google.crypto.tink/tink {:mvn/version "1.23.0"}

        ;; Crypto: caesium (libsodium binding — alternative ICrypto adapter)
        caesium/caesium {:mvn/version "0.15.0"}
        metosin/malli {:mvn/version "0.20.1"}}

 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.9"}}
          :ns-default hive-build.api}

  :dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.3.12"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.14"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
